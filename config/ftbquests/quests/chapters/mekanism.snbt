	quests: [
		{
			description: [
				"The Naquadah Reactor comes from the Mekanism Extra mod."
				""
				"This reactor produces &7Polonium Containing Steam&r which through refining processes can be turned into a lot of &2Polonium&r and thus, a lot of &5Antimatter&r."
				""
				"And trust me, you will want a lot of &5Antimatter&r."
			]
			id: "0E5CD46C5A26BEC0"
			min_width: 250
			rewards: [{
				id: "739CC987ACD00C9C"
