				}
			]
			x: -16.125d
			y: -8.125d
		}
		{
			dependencies: ["753F63B99BD9EEA2"]
			description: [
				"To get this, you need to make the Advance Pump (with the Ionic Membrane Upgrade) pump a source block of Naquadah Hexafluoride."
				""
				"To place Naquadah Hexafluoride in the world, you can use Formation Planes from AE2 or Fluid Placers from one of the 4 mods that adds one."
			]
			id: "164C61193E91BE31"
			rewards: [{
